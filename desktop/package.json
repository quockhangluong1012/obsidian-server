{
  "name": "desktop",
  "private": true,
  "version": "0.0.0",
  "main": "main.js",
  "scripts": {
    "build:web": "npm run build --prefix ../client -- --mode electron",
    "icons": "node scripts/generate-icon.mjs && electron-icon-builder --input=build/icon.png --output=build",
    "start": "electron .",
    "dist": "npm run build:web && electron-builder"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-icon-builder": "^2.0.1",
    "sharp": "^0.35.4"
  },
  "build": {
    "appId": "com.obsidianlite.desktop",
    "productName": "Obsidian Vault",
    "files": [
      "main.js"
    ],
    "extraResources": [
      {
        "from": "../client/dist",
        "to": "dist"
      }
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icons/mac/icon.icns",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icons/win/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icons/png",
      "category": "Office"
    }
  }
}
