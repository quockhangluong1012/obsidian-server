{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ObsidianDatabase": "REPLACE_IN_CD"
  },
  "Storage": {
    "Provider": "VercelBlob"
  },
  "VercelBlob": {
    "Token": "REPLACE_IN_CD",
    "BaseUrl": "REPLACE_IN_CD",
    "KeyPrefix": "obsidian/",
    "AddRandomSuffix": true
  }
}
