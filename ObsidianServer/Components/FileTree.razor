@*
    Recursive file explorer. A null Folder renders the vault root, so the root and
    every nested level share one code path (including the inline "new/rename folder" row).
*@
@implements IDisposable

@if (Folder is FolderSummary folder)
{
    @if (Tree.IsRenamingFolder(folder.Id))
    {
        <div class="nav-new-folder" style="padding-left:@(IndentPx)px">
            <input @ref="renameInput" value="@Tree.RenamingInitialName" placeholder="Folder name" autocomplete="off" spellcheck="false"
                   aria-label="Rename folder"
                   @onchange="args => Tree.CommitFolderDraft.InvokeAsync(args.Value?.ToString() ?? string.Empty)"
                   @onkeydown="KeyPressedAsync"
                   @onblur="() => Tree.CancelFolderDraft.InvokeAsync()" />
        </div>
    }
    else
    {
        <button type="button"
                class="nav-row @(Tree.ActiveFolderId == folder.Id ? "is-active" : null) @(Tree.DragOverFolderId == folder.Id ? "is-drag-over" : null) @(Tree.Dragging?.Id == folder.Id ? "is-dragging" : null)"
                aria-expanded="@Tree.IsExpanded(folder.Id)"
                draggable="true"
                @onclick="() => OpenFolderAsync(folder)"
                @oncontextmenu="e => Tree.ShowMenu.InvokeAsync(new MenuRequest(e.ClientX, e.ClientY, VaultNodeKind.Folder, folder.Id, folder.Name))"
                @oncontextmenu:preventDefault="true"
                @ondragstart="() => Tree.BeginDrag.InvokeAsync(new DragItem(folder.Id, VaultNodeKind.Folder, folder.Name))"
                @ondragend="() => Tree.EndDrag.InvokeAsync()"
                @ondragover="() => Tree.DragOverFolderId = folder.Id"
                @ondragover:preventDefault="CanDropOnFolder(folder.Id)"
                @ondragleave="() => Tree.DragOverFolderId = null"
                @ondrop="() => DropOnFolderAsync(folder.Id)"
                @ontouchstart="() => StartPress(folder.Id, VaultNodeKind.Folder, folder.Name)"
                @ontouchend="CancelPress"
                @ontouchmove="CancelPress">
            <span class="nav-chevron @(Tree.IsExpanded(folder.Id) ? "is-open" : null)"><Icon Name="chevron-right" Size="14" /></span>
            <Icon Name="@(Tree.IsExpanded(folder.Id) ? "folder-open" : "folder")" Size="15" />
            <span class="nav-text">@folder.Name</span>
        </button>
    }
}

@if (Folder is null || Tree.IsExpanded(Folder.Id))
{
    <div class="nav-children @(Folder is null ? "nav-root" : null) @(Folder is null && Tree.DragOverRoot ? "is-drag-over" : null)"
         @ondragover="() => Tree.DragOverRoot = Folder is null"
         @ondragover:preventDefault="Folder is null"
         @ondragleave="() => Tree.DragOverRoot = false"
         @ondrop="() => DropOnFolderAsync(null)">
        @foreach (var child in Tree.Subfolders(Folder?.Id))
        {
            <FileTree Folder="child" Tree="Tree" Depth="Depth + 1" />
        }
        @foreach (var note in Tree.NotesIn(Folder?.Id))
        {
            <button type="button"
                    class="nav-row nav-file @(Tree.ActiveNoteId == note.Id ? "is-active" : null) @(Tree.Dragging?.Id == note.Id ? "is-dragging" : null)"
                    style="padding-left:@(IndentPx + 20)px"
                    draggable="true"
                    @onclick="() => Tree.OpenNote.InvokeAsync(note.Id)"
                    @oncontextmenu="e => Tree.ShowMenu.InvokeAsync(new MenuRequest(e.ClientX, e.ClientY, VaultNodeKind.Note, note.Id, note.Title))"
                    @oncontextmenu:preventDefault="true"
                    @ondragstart="() => Tree.BeginDrag.InvokeAsync(new DragItem(note.Id, VaultNodeKind.Note, note.Title))"
                    @ondragend="() => Tree.EndDrag.InvokeAsync()"
                    @ontouchstart="() => StartPress(note.Id, VaultNodeKind.Note, note.Title)"
                    @ontouchend="CancelPress"
                    @ontouchmove="CancelPress">
                <Icon Name="file-text" Size="14" />
                <span class="nav-text">@note.Title</span>
            </button>
        }
        @foreach (var attachment in Tree.AttachmentsIn(Folder?.Id))
        {
            <button type="button"
                    class="nav-row nav-file nav-attachment @(Tree.OpenAttachmentId == attachment.Id ? "is-active" : null) @(Tree.Dragging?.Id == attachment.Id ? "is-dragging" : null)"
                    style="padding-left:@(IndentPx + 20)px"
                    draggable="true"
                    @onclick="() => Tree.OpenAttachment.InvokeAsync(attachment.Id)"
                    @oncontextmenu="e => Tree.ShowMenu.InvokeAsync(new MenuRequest(e.ClientX, e.ClientY, VaultNodeKind.Attachment, attachment.Id, attachment.FileName))"
                    @oncontextmenu:preventDefault="true"
                    @ondragstart="() => Tree.BeginDrag.InvokeAsync(new DragItem(attachment.Id, VaultNodeKind.Attachment, attachment.FileName))"
                    @ondragend="() => Tree.EndDrag.InvokeAsync()"
                    @ontouchstart="() => StartPress(attachment.Id, VaultNodeKind.Attachment, attachment.FileName)"
                    @ontouchend="CancelPress"
                    @ontouchmove="CancelPress">
                <Icon Name="@(attachment.ContentType == "image/svg+xml" ? "shapes" : "image")" Size="14" />
                <span class="nav-text">@attachment.FileName</span>
            </button>
        }
        @if (IsEmpty())
        {
            <div class="nav-empty" style="padding-left:@(IndentPx + 20)px">Empty folder</div>
        }
        @if (Tree.ShowsNewFolderRow(Folder?.Id))
        {
            <div class="nav-new-folder" style="padding-left:@(IndentPx + 20)px">
                <input @ref="nameInput"
                       placeholder="Folder name"
                       autocomplete="off"
                       spellcheck="false"
                       aria-label="New folder name"
                       @onchange="args => Tree.CommitFolderDraft.InvokeAsync(args.Value?.ToString() ?? string.Empty)"
                       @onkeydown="KeyPressedAsync"
                       @onblur="() => Tree.CancelFolderDraft.InvokeAsync()" />
            </div>
        }
    </div>
}

@code {
    [Parameter] public FolderSummary? Folder { get; set; }
    [Parameter, EditorRequired] public VaultTree Tree { get; set; } = default!;
    [Parameter] public int Depth { get; set; }

    private ElementReference nameInput;
    private ElementReference renameInput;
    private bool nameFocused;
    private bool renameFocused;
    private System.Threading.Timer? pressTimer;

    private int IndentPx => 6 + Depth * 14;

    private bool IsEmpty() =>
        Tree.NotesIn(Folder?.Id).Count == 0 && Tree.AttachmentsIn(Folder?.Id).Count == 0 && Tree.Subfolders(Folder?.Id).Count == 0 && !Tree.ShowsNewFolderRow(Folder?.Id);

    private bool CanDropOnFolder(Guid folderId) => Tree.Dragging is { } dragging && dragging.Id != folderId;

    private async Task OpenFolderAsync(FolderSummary folder)
    {
        await Tree.SelectFolder.InvokeAsync(folder.Id);
        await Tree.ToggleFolder.InvokeAsync(folder.Id);
    }

    private async Task DropOnFolderAsync(Guid? folderId)
    {
        Tree.DragOverFolderId = null;
        Tree.DragOverRoot = false;
        if (Tree.Dragging is null) return;
        await Tree.Drop.InvokeAsync(folderId);
    }

    private void StartPress(Guid id, VaultNodeKind kind, string name)
    {
        pressTimer?.Dispose();
        pressTimer = new System.Threading.Timer(_ => InvokeAsync(() => Tree.ShowMenu.InvokeAsync(new MenuRequest(0, 0, kind, id, name))), null, 480, System.Threading.Timeout.Infinite);
    }

    private void CancelPress()
    {
        pressTimer?.Dispose();
        pressTimer = null;
    }

    // Enter and blur both raise onchange, which carries the typed name; Escape abandons the row.
    private async Task KeyPressedAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") await Tree.CancelFolderDraft.InvokeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var showsNewRow = Tree.ShowsNewFolderRow(Folder?.Id);
        if (!showsNewRow) nameFocused = false;
        else if (!nameFocused) { nameFocused = true; await nameInput.FocusAsync(); }

        var showsRenameRow = Folder is not null && Tree.IsRenamingFolder(Folder.Id);
        if (!showsRenameRow) renameFocused = false;
        else if (!renameFocused) { renameFocused = true; await renameInput.FocusAsync(); }
    }

    public void Dispose() => pressTimer?.Dispose();
}
