@using ObsidianServer.Features.Attachments
@inject AttachmentService Attachments

<div class="editor-surface">
    @* The textarea is uncontrolled: its text is written once per (note, revision).
       Rendering `value` on every keystroke lets a render batch overwrite the DOM value
       mid-typing, which silently drops and reorders characters over a Server circuit. *@
    <textarea @key="(NoteId, revision)"
              @ref="surface"
              class="markdown-source"
              placeholder="Start writing…"
              spellcheck="false"
              aria-label="Markdown source"
              @oninput="ChangedAsync"
              @onpaste="PasteAsync">@initial</textarea>
    <label class="attach-btn" title="Insert an image or SVG">
        <Icon Name="image-plus" Size="14" />
        <span>@status</span>
        <InputFile accept="image/jpeg,image/png,image/gif,image/webp,image/svg+xml" OnChange="UploadAsync" />
    </label>
</div>

@code {
    [Parameter] public Guid NoteId { get; set; }
    [Parameter] public Guid? FolderId { get; set; }
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Inject] private IJSRuntime JavaScript { get; set; } = default!;

    private const string Idle = "Insert image — or paste one";

    private ElementReference surface;
    private string status = Idle;
    private string initial = string.Empty;
    private string? typed;
    private Guid loadedNote;
    private int revision;
    private bool reload = true;
    private bool forceRender;
    private bool restoreFocus;

    protected override void OnParametersSet()
    {
        if (!reload && NoteId == loadedNote) return;
        reload = false;
        loadedNote = NoteId;
        initial = Value;
        typed = Value;
        revision++;
        forceRender = true;
    }

    protected override bool ShouldRender()
    {
        if (forceRender)
        {
            forceRender = false;
            return true;
        }
        return Value != typed;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!restoreFocus) return;
        restoreFocus = false;
        await surface.FocusAsync();
    }

    private Task ChangedAsync(ChangeEventArgs args)
    {
        typed = args.Value?.ToString() ?? string.Empty;
        return ValueChanged.InvokeAsync(typed);
    }

    /// <summary>Drains the textarea's current DOM value through ValueChanged so the
    /// parent sees every keystroke before it decides to persist or tear the editor down.
    /// Required because @oninput events can race a click that toggles reading view —
    /// the click can otherwise save a stale snapshot and silently drop the last character.</summary>
    public async Task FlushAsync()
    {
        var current = await JavaScript.InvokeAsync<string>("obsidian.readTextarea", surface);
        if (string.IsNullOrEmpty(current) && string.IsNullOrEmpty(typed)) return;
        if (current == typed) return;
        typed = current;
        await ValueChanged.InvokeAsync(typed);
    }

    /// <summary>Rewrites the surface with server-inserted markdown (upload, paste).</summary>
    private Task InsertAsync(string markdown)
    {
        reload = true;
        restoreFocus = true;
        return ValueChanged.InvokeAsync(markdown);
    }

    private async Task UploadAsync(InputFileChangeEventArgs args)
    {
        try
        {
            await using var stream = args.File.OpenReadStream(AttachmentService.MaximumFileSize);
            var file = await Attachments.SaveAsync(args.File.Name, args.File.ContentType, stream, args.File.Size, FolderId, NoteId);
            status = Idle;
            await InsertAsync($"{typed ?? Value}\n![]({file.Url})\n");
        }
        catch (Exception exception)
        {
            status = exception.Message;
            forceRender = true;
        }
    }

    private async Task PasteAsync(ClipboardEventArgs args)
    {
        var markdown = await JavaScript.InvokeAsync<string?>("obsidian.uploadPastedImage", NoteId, FolderId);
        if (string.IsNullOrEmpty(markdown)) return;
        await InsertAsync((typed ?? Value) + markdown);
    }
}
