@* Ctrl+K quick jump — instant substring filter over every folder and note already loaded in memory. *@

@if (Open)
{
    <div class="modal-scrim" @onclick="() => OnClose.InvokeAsync()"></div>
    <div class="command-palette" role="dialog" aria-modal="true">
        <div class="palette-input">
            <Icon Name="search" Size="18" />
            <input @ref="input" value="@query" placeholder="Search notes or folders…" autocomplete="off" spellcheck="false"
                   aria-label="Search notes or folders" @oninput="args => query = args.Value?.ToString() ?? string.Empty" />
            <button type="button" class="ico-btn" title="Close" aria-label="Close" @onclick="() => OnClose.InvokeAsync()"><Icon Name="x" Size="16" /></button>
        </div>
        <div class="palette-results">
            @if (Filtered().Count == 0)
            {
                <div class="palette-empty">No matches.</div>
            }
            else
            {
                @foreach (var entry in Filtered())
                {
                    <button type="button" class="palette-result" @onclick="() => OnSelect.InvokeAsync(entry)">
                        <Icon Name="@(entry.IsFolder ? "folder" : "file-text")" Size="18" />
                        <span class="palette-result-text">
                            <span class="palette-result-name">@entry.Name</span>
                            <span class="palette-result-path">@entry.Path</span>
                        </span>
                        <span class="palette-result-kind">@(entry.IsFolder ? "folder" : "note")</span>
                    </button>
                }
            }
        </div>
    </div>
}

@code {
    public sealed record PaletteEntry(Guid Id, string Name, string Path, bool IsFolder);

    [Parameter] public bool Open { get; set; }
    [Parameter] public IReadOnlyList<PaletteEntry> Entries { get; set; } = [];
    [Parameter] public EventCallback<PaletteEntry> OnSelect { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private ElementReference input;
    private string query = string.Empty;
    private bool wasOpen;
    private bool focused;

    private List<PaletteEntry> Filtered()
    {
        var term = query.Trim();
        var matches = term.Length == 0
            ? Entries.AsEnumerable()
            : Entries.Where(entry => entry.Name.Contains(term, StringComparison.CurrentCultureIgnoreCase));
        return matches.Take(20).ToList();
    }

    protected override void OnParametersSet()
    {
        if (Open == wasOpen) return;
        wasOpen = Open;
        if (Open) { query = string.Empty; focused = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Open || focused) return;
        focused = true;
        await input.FocusAsync();
    }
}
